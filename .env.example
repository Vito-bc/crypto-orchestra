# Copy this file to .env and fill in the values you need.
# NEVER commit .env to git — it is already in .gitignore.

# ── Anthropic Claude API (required) ──────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Coinbase Advanced Trade API (only needed for DRY_RUN=false) ──────────────
# Authentication uses an ECDSA key FILE, not env vars. Download cdp_api_key.json
# from https://www.coinbase.com/settings/api and place it in the project root;
# the client is built as RESTClient(key_file="cdp_api_key.json"). The file is
# gitignored and must never be committed.
#
# Required key permissions: can_view=true, can_trade=true, can_transfer=FALSE.
# Preflight treats can_transfer=true as a blocking error — the bot must never
# hold withdrawal rights.
#
# COINBASE_PORTFOLIO_UUID is MANDATORY before DRY_RUN=false. Preflight blocks
# ENTRY when it is unset, and fails CRITICAL when the key exposes multiple
# portfolios without one pinned here. Find it in the Coinbase portfolio URL or
# via GET /api/v3/brokerage/portfolios.
COINBASE_PORTFOLIO_UUID=

# ── Telegram alerts (optional but recommended) ────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Trading settings ──────────────────────────────────────────────────────────
TRADE_SIZE_PCT=0.02      # fraction of portfolio per trade (0.02 = 2%)
MAX_POSITIONS=5          # max concurrent open positions
DAILY_LOSS_LIMIT=0.05    # halt trading if daily loss exceeds 5%
# Per-trade SIZING BASELINE, not an enforced aggregate spending cap. Order size
# = LIVE_BALANCE_USD × position_size_pct. It is NOT compared against the real
# Coinbase balance, and with MAX_POSITIONS concurrent trades total exposure can
# exceed it. A true hard cap needs a dedicated portfolio plus an aggregate
# exposure limit (not yet implemented). Do not treat this as a spend ceiling.
LIVE_BALANCE_USD=100
DRY_RUN=true             # set to false ONLY after the live-read preflight passes

# ── Live-read preflight (safe to run while DRY_RUN=true) ─────────────────────
# Performs real Coinbase GET calls through a read-only facade that has no
# create_order / cancel_order / transfer methods. No orders can be placed.
# Readiness requires overall_status == "OK" AND an EMPTY blocked_products (a
# product fault blocks only that asset and does NOT change overall_status).
# Run this and require exit code 0 BEFORE flipping DRY_RUN=false:
#
#   venv\Scripts\python.exe -c "import sys; from pipeline.preflight import run_preflight; \
#     r = run_preflight(['ETH-USD','ZEC-USD'], live_reads=True); \
#     print(r.overall_status, r.errors, r.blocked_products); \
#     sys.exit(0 if (r.overall_status == 'OK' and not r.blocked_products) else 1)"

# ── Optional: override Claude model for sub-agents (default: haiku) ──────────
# SUBAGENT_MODEL=claude-haiku-4-5-20251001

# ── Optional: override scheduler interval ────────────────────────────────────
# PIPELINE_INTERVAL_MINUTES=60
