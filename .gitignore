# Python
__pycache__/
*.py[cod]
*.pyd
*.pyo
*.so
.Python
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
venv/
.venv/
env/

# Secrets and local config
.env
.env.*
!.env.example

# IDE and OS files
.vscode/
.idea/
*.swp
Thumbs.db
.DS_Store

# Logs and runtime artifacts
logs/
*.log
!logs/.gitkeep

# Local data and outputs
data/
*.csv
*.parquet
*.sqlite
*.db
!data/.gitkeep

# Committed research deliverables (inventories, not the raw candle cache).
# The directory itself must be un-ignored before anything inside it can be,
# but only the TEXT deliverables are: a .db, .parquet or .sqlite that lands
# here is still local data and stays ignored.
!docs/research/data/
!docs/research/data/*.csv
!docs/research/data/*.md

# Coverage and reports
.coverage
htmlcov/
coverage.xml

# Build artifacts
build/
dist/
*.egg-info/

# Obsidian vault — personal knowledge base, not versioned
obsidian_vault/
cdp_api_key.json

# Editor workspace — per-developer, not versioned
*.code-workspace
